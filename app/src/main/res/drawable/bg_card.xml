<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo blanco cálido -->
    <solid android:color="@color/surface" />

    <!-- Esquinas suaves -->
    <corners android:radius="22dp" />

    <!-- Borde color crema -->
    <stroke
        android:width="1dp"
        android:color="@color/border" />

    <!-- Espacio interior -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />

</shape>
