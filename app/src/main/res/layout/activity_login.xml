<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EBDD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- LOGO TEMPORAL -->
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="☕"
            android:textSize="55sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button" />

        <!-- NOMBRE DEL NEGOCIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="404 CAFÉ"
            android:textColor="#E87520"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENCONTRADO"
            android:textColor="#593B25"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tu lugar favorito está a un clic"
            android:textColor="#806B59"
            android:textSize="14sp" />

        <!-- TARJETA DE INICIO DE SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Qué gusto verte!"
                android:textColor="#382419"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Inicia sesión en tu cuenta"
                android:textColor="#806B59"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Correo electrónico"
                android:textColor="#382419"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="tucorreo@ejemplo.com"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#382419"
                android:textColorHint="#9B9087" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contraseña"
                android:textColor="#382419"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#382419"
                android:textColorHint="#9B9087" />

            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B3261E"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#B85C16"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/goRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="¿No tienes cuenta? Regístrate"
                android:textColor="#593B25"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="BUEN CAFÉ · BUENOS MOMENTOS"
            android:textColor="#806B59"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

    </LinearLayout>
</ScrollView>
