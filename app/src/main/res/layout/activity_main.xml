<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_bg_brown"
    android:padding="16dp">

    <!-- Encabezado con Logo y Usuario -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/imgMainLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_compass"
            android:contentDescription="Logo 404 Café Encontrado"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tvWelcomeUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido/a"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_toEndOf="@id/imgMainLogo"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp" />

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regresar"
            android:textColor="@color/black"
            android:backgroundTint="@color/cafe_btn_top"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Opciones del Menú Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnOption1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Disponibilidad\nde PC"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />

                <Button
                    android:id="@+id/btnOption2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Registro de\nClientes"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnOption3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Snacks"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />

                <Button
                    android:id="@+id/btnOption4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Tiempo de\nReserva"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOption5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Cobro"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />

                <Button
                    android:id="@+id/btnOption6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Reporte\nFinal"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/cafe_btn_top" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>