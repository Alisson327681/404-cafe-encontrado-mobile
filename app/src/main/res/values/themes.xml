<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">

        <!-- Tipografía general -->
        <item name="android:fontFamily">sans</item>

        <!-- Colores de los controles -->
        <item name="android:colorAccent">@color/orange</item>

        <!-- Barra superior del teléfono -->
        <item name="android:statusBarColor">@color/coffee_dark</item>

        <!-- Barra inferior de navegación -->
        <item name="android:navigationBarColor">@color/coffee_dark</item>

        <!-- Iconos claros en las barras del sistema -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Fondo general -->
        <item name="android:windowBackground">@color/cream</item>

    </style>

</resources>
